# ==========================================
# VINALEX - BIẾN MÔI TRƯỜNG (.env.example)
# ==========================================
# Hướng dẫn: Copy file này thành .env và thay đổi các giá trị phù hợp với máy local.
# CẢNH BÁO: Không bao giờ commit file .env (chứa thông tin thật) lên Git.

# 1. CẤU HÌNH SERVER BACKEND (FastAPI)
# ------------------------------------------
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=chuoi-ky-tu-bao-mat-dai-va-ngau-nhien-thay-doi-khi-len-production
ADMIN_SECRET_KEY=vinalex-admin-2024
# Cho phép Frontend kết nối (CORS)
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# 2. CƠ SỞ DỮ LIỆU CHÍNH (PostgreSQL)
# ------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mat_khau_database_local
POSTGRES_PORT=5432
POSTGRES_DB=vinalex_db
# Chuỗi kết nối dùng asyncpg để hỗ trợ bất đồng bộ cho FastAPI
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# 3. LƯU TRỮ TẠM THỜI & DỌN RÁC (Redis) - Tuân thủ bảo mật
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
# Thời gian sống tối đa của file hồ sơ trên RAM (giây) - Đảm bảo tự động hủy
FILE_SESSION_TTL=300 

# 4. MÔ HÌNH THỊ GIÁC MÁY & OCR (Computer Vision)
# ------------------------------------------
# Đường dẫn lưu trữ trọng số mô hình đã được tải về sẵn trong thư mục data/
YOLO_OBB_WEIGHTS=./data/weights/yolo_layout_obb.pt
VIETOCR_WEIGHTS=./data/weights/vgg_seq2seq.pth
# Thiết bị chạy suy luận: 'cpu' hoặc 'cuda:0' (nếu có NVIDIA GPU)
INFERENCE_DEVICE=cpu 

# 5. MÔ HÌNH NGÔN NGỮ & TRA CỨU LUẬT (RAG / Local LLM)
# ------------------------------------------
# Kết nối đến máy chủ Ollama chạy local
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:latest
# Kết nối đến Vector Database (Mặc định dùng Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Mô hình nhúng ngôn ngữ (Embedding) cho tiếng Việt
EMBEDDING_MODEL_NAME=keepitreal/vietnamese-sbert

# 6. MÔ HÌNH GEMINI PRO / FLASH AGENT
# Điền API Key của bạn từ Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash